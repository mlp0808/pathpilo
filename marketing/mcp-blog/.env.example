# Required — shared secret Grok sends as: Authorization: Bearer <token>
BLOG_MCP_TOKEN=replace-with-a-long-random-secret

# Listen (defaults shown)
BLOG_MCP_PORT=8787
BLOG_MCP_HOST=0.0.0.0

# Optional: comma-separated Host headers allowed (set this when behind a public domain)
# BLOG_MCP_ALLOWED_HOSTS=blog-mcp.example.com,localhost

# Optional: block all writes (list/get only)
# BLOG_MCP_READONLY=1
